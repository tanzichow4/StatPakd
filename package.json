{
  "name": "statpakd",
  "private": true,
  "description": "Convenience scripts that forward to the web/ app. Run them from the repo root.",
  "scripts": {
    "install:web": "npm install --prefix web",
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "preview": "npm run preview --prefix web",
    "lint": "npm run lint --prefix web",
    "typecheck": "npm run typecheck --prefix web",
    "test": "npm test --prefix web",
    "format": "npm run format --prefix web",
    "format:check": "npm run format:check --prefix web",
    "test:e2e": "npm run test:e2e --prefix web"
  }
}
